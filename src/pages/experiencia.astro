            <span class="experience-period">May 2017 – May 2018</span>
          </div>
          <p class="experience-company">2Com Consulting · On-site</p>
          <ul class="responsibilities">
            <li>Configure monitoring tools and collect system and network metrics</li>
            <li>Analyze alerts and incidents</li>
            <li>Resolve availability and performance issues</li>
            <li>Develop scripts and automate tasks</li>
            <li>Implement customized monitoring solutions</li>
            <li>Technical support and documentation</li>
          </ul>
          <div class="tech-tags">
            <span class="tag">Linux</span>
            <span class="tag">Bash</span>
            <span class="tag">Monitoring</span>
            <span class="tag">OpenVPN</span>
            <span class="tag">Networking</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .timeline {
    position: relative;
    padding: 2rem 0;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 20px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--green), transparent);
  }

  .timeline-item {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 3rem;
    position: relative;
  }

  .timeline-marker {
    width: 40px;
    height: 40px;
    background: var(--bg);
    border: 2px solid var(--green);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .timeline-marker::after {
    content: "";
    width: 12px;
    height: 12px;
    background: var(--green);
    border-radius: 50%;
  }

  .timeline-content {
    flex: 1;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1.5rem;
  }

  .experience-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .experience-title {
    color: var(--green);
    font-size: 1.25rem;
    margin: 0;
    font-weight: 600;
  }

  .experience-period {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .experience-company {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin: 0.5rem 0 1rem 0;
    font-family: var(--font-mono);
  }

  .experience-clients {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .client-badge {
    background: rgba(0, 255, 153, 0.1);
    border: 1px solid rgba(0, 255, 153, 0.3);
    color: var(--green);
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .responsibilities {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
  }

  .responsibilities li {
    color: var(--text);
    padding: 0.5rem 0;
    padding-left: 1.25rem;
    position: relative;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .responsibilities li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--blue);
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .tag {
    background: rgba(88, 166, 255, 0.1);
    border: 1px solid rgba(88, 166, 255, 0.2);
    color: var(--blue);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-family: var(--font-mono);
  }
</style>
