---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Experience | Jorge Gabriel" activeNav="/experiencia">
  <div class="page-content">
    <header class="section">
      <h1 class="page-title">Experience</h1>
      <p class="page-subtitle">My professional journey</p>
    </header>

    <div class="timeline">
      <div class="timeline-item">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <div class="experience-header">
            <h3 class="experience-title">Site Reliability Engineer</h3>
            <span class="experience-period">Jun 2024 – Present</span>
          </div>
          <p class="experience-company">PicPay · Full-time · Remote</p>
          <ul class="responsibilities">
            <li>Monitor, analyze, and resolve observability issues in infrastructure, services, and applications in production</li>
            <li>Implement infrastructure improvements and automation solutions using Bash Script and Python</li>
            <li>Share knowledge through communication channels and comprehensive documentation</li>
            <li>Support development teams and implement SRE best practices</li>
            <li>Achieved 33% cloud resource reduction using StormForge optimization tool</li>
            <li>Developed serverless security solutions with AWS Lambda for IAM vulnerability detection</li>
            <li>Implemented multiple Disaster Recovery project phases</li>
            <li>Develop infrastructure and automation solutions in Golang</li>
          </ul>
          <div class="tech-tags">
            <span class="tag">AWS</span>
            <span class="tag">EKS</span>
            <span class="tag">Kubernetes</span>
            <span class="tag">Docker</span>
            <span class="tag">Go</span>
            <span class="tag">Python</span>
            <span class="tag">Lambda</span>
            <span class="tag">ArgoCD</span>
            <span class="tag">Prometheus</span>
            <span class="tag">Grafana</span>
            <span class="tag">Helm</span>
          </div>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <div class="experience-header">
            <h3 class="experience-title">Career Pause</h3>
            <span class="experience-period">Feb 2024 – Jun 2024</span>
          </div>
          <p class="experience-company">5 months · Goiânia, Goiás</p>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <div class="experience-header">
            <h3 class="experience-title">Site Reliability Engineer</h3>
            <span class="experience-period">Dec 2022 – Feb 2024</span>
          </div>
          <p class="experience-company">Itaú Unibanco · Full-time · Remote</p>
          <ul class="responsibilities">
            <li>Disseminate SRE practices across squads</li>
            <li>Focus on observability and incident resolution</li>
            <li>Manage Cloud Native microservices infrastructure</li>
            <li>Support development teams</li>
          </ul>
          <div class="tech-tags">
            <span class="tag">Cloud Native</span>
            <span class="tag">Service Mesh</span>
            <span class="tag">Kubernetes</span>
            <span class="tag">CI/CD</span>
            <span class="tag">Observability</span>
            <span class="tag">IaC</span>
            <span class="tag">Agile</span>
          </div>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <div class="experience-header">
            <h3 class="experience-title">Site Reliability Engineer</h3>
            <span class="experience-period">Aug 2021 – Nov 2022</span>
          </div>
          <p class="experience-company">Petlove&Co · Full-time · Remote</p>
          <ul class="responsibilities">
            <li>Define and evolve microservices distribution architecture</li>
            <li>Maintain Google Cloud infrastructure</li>
            <li>Ensure operational growth sustainability</li>
            <li>Participate in infrastructure, cloud, architecture, and security initiatives</li>
            <li>Support development teams</li>
          </ul>
          <div class="tech-tags">
            <span class="tag">Google Cloud</span>
            <span class="tag">Cloud Native</span>
            <span class="tag">Service Mesh</span>
            <span class="tag">Containers</span>
            <span class="tag">CI/CD</span>
            <span class="tag">Agile</span>
          </div>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <div class="experience-header">
            <h3 class="experience-title">IT Infrastructure Analyst</h3>
            <span class="experience-period">Jun 2018 – Aug 2021</span>
          </div>
          <p class="experience-company">Soluti Certificação Digital · Hybrid</p>
          <ul class="responsibilities">
            <li>Infrastructure planning and design</li>
            <li>Server and network installation and configuration</li>
            <li>Operating system administration and monitoring</li>
            <li>Network and server diagnostics</li>
            <li>Backup and disaster recovery</li>
            <li>Information security implementation</li>
            <li>Task automation and infrastructure optimization</li>
          </ul>
          <div class="tech-tags">
            <span class="tag">Linux</span>
            <span class="tag">Bash</span>
            <span class="tag">Load Balancer</span>
