---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Jorge Gabriel | SRE & Cloud Engineer" description="Site Reliability Engineer specializing in Kubernetes, AWS, Go, and DevOps automation." activeNav="/">
  <main>

    <!-- Hero -->
    <section class="hero">
      <div class="terminal-header">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
        <span class="terminal-title">jorge@sre:~</span>
      </div>
      <div class="terminal-body">
        <p class="prompt"><span class="dollar">$</span> whoami</p>
        <h1 class="name">Jorge Gabriel</h1>
        <p class="prompt"><span class="dollar">$</span> cat role.txt</p>
        <p class="role">Site Reliability Engineer <span class="cursor">▋</span></p>
        <p class="prompt"><span class="dollar">$</span> cat bio.txt</p>
        <p class="bio">
          I use <strong>Linux</strong>, <strong>Go</strong>, <strong>Containers</strong>, and <strong>AI</strong>
          to solve problems and ensure the reliability of applications in critical environments.
        </p>
        <p class="prompt"><span class="dollar">$</span> ./connect.sh</p>
        <div class="links">
          <a href="https://linkedin.com/in/jorge-gabriel" target="_blank" class="link-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
          <a href="https://github.com/jorgegabrielti" target="_blank" class="link-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            GitHub
          </a>
          <a href="https://medium.com/@jorgegabriel.ti" target="_blank" class="link-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M13.54 12a6.8 6.8 0 0 1-6.77 6.82A6.8 6.8 0 0 1 0 12a6.8 6.8 0 0 1 6.77-6.82A6.8 6.8 0 0 1 13.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
            Medium
          </a>
        </div>
      </div>
    </section>

    <!-- Core Skills -->
    <section class="section">
      <h2 class="section-title"><span class="hash">#</span> Core Skills</h2>
      <div class="skills-grid">
        <div class="skill-card"><span class="skill-name">SRE</span></div>
        <div class="skill-card"><span class="skill-name">DevOps</span></div>
        <div class="skill-card"><span class="skill-name">GitOps</span></div>
        <div class="skill-card"><span class="skill-name">Linux</span></div>
        <div class="skill-card"><span class="skill-name">Network</span></div>
        <div class="skill-card"><span class="skill-name">Cloud Computing</span></div>
        <div class="skill-card"><span class="skill-name">Artificial Intelligence</span></div>
        <div class="skill-card"><span class="skill-name">Development</span></div>
        <div class="skill-card"><span class="skill-name">Containers</span></div>
        <div class="skill-card"><span class="skill-name">IaC</span></div>
        <div class="skill-card"><span class="skill-name">Agile</span></div>
      </div>
    </section>

    <!-- Tech Stack -->
    <section class="section">
      <h2 class="section-title"><span class="hash">#</span> Tech Stack</h2>
      <div class="stack-grid">
        <a href="https://go.dev" target="_blank" class="stack-item"><img src="https://skillicons.dev/icons?i=go" alt="Go" /><span>Go</span></a>
        <a href="https://www.python.org" target="_blank" class="stack-item"><img src="https://skillicons.dev/icons?i=python" alt="Python" /><span>Python</span></a>
        <a href="https://www.gnu.org/software/bash/" target="_blank" class="stack-item"><img src="https://skillicons.dev/icons?i=bash" alt="Bash" /><span>Bash</span></a>
        <a href="https://kernel.org" target="_blank" class="stack-item"><img src="https://skillicons.dev/icons?i=linux" alt="Linux" /><span>Linux</span></a>
        <a href="https://aws.amazon.com" target="_blank" class="stack-item"><img src="https://skillicons.dev/icons?i=aws" alt="AWS" /><span>AWS</span></a>
        <a href="https://www.docker.com" target="_blank" class="stack-item"><img src="https://skillicons.dev/icons?i=docker" alt="Docker" /><span>Docker</span></a>
        <a href="https://kubernetes.io" target="_blank" class="stack-item"><img src="https://skillicons.dev/icons?i=kubernetes" alt="Kubernetes" /><span>Kubernetes</span></a>
        <a href="https://developer.hashicorp.com/terraform" target="_blank" class="stack-item"><img src="https://skillicons.dev/icons?i=terraform" alt="Terraform" /><span>Terraform</span></a>
        <a href="https://www.ansible.com" target="_blank" class="stack-item"><img src="https://skillicons.dev/icons?i=ansible" alt="Ansible" /><span>Ansible</span></a>
        <a href="https://github.com/features/actions" target="_blank" class="stack-item"><img src="https://skillicons.dev/icons?i=githubactions" alt="GitHub Actions" /><span>GH Actions</span></a>
        <a href="https://grafana.com" target="_blank" class="stack-item"><img src="https://skillicons.dev/icons?i=grafana" alt="Grafana" /><span>Grafana</span></a>
      </div>
    </section>

    <!-- Certifications -->
    <section class="section">
      <h2 class="section-title"><span class="hash">#</span> Certifications</h2>
      <div class="cert-grid">
        <a href="https://www.credly.com/badges/d9499388-ce5e-4f4f-a18d-6c32eb4582a5/public_url" target="_blank" class="cert-card">
          <span class="cert-icon">☁️</span>
          <div>
            <p class="cert-name">AWS Certified AI Practitioner</p>
            <p class="cert-issuer">Amazon Web Services</p>
          </div>
        </a>
        <a href="https://www.credly.com/badges/c9572e3b-4e2e-46d5b7dba971b8dbe1b0/linked_in_profile" target="_blank" class="cert-card">
          <span class="cert-icon">☁️</span>
          <div>
            <p class="cert-name">AWS Certified Cloud Practitioner</p>
            <p class="cert-issuer">Amazon Web Services</p>
          </div>
        </a>
      </div>
    </section>

    <!-- Articles -->
    <section class="section">
      <h2 class="section-title"><span class="hash">#</span> Latest Articles</h2>
      <div class="articles-list">
        <a href="https://medium.com/@jorgegabriel.ti/iniciando-a-jornada-em-go-do-absoluto-zero-ao-seu-primeiro-m%C3%B3dulo-01382acf4dbc" target="_blank" class="article-item">
          <span class="article-arrow">→</span>
          <span>Iniciando a jornada em Go: do absoluto Zero ao seu primeiro módulo</span>
        </a>
        <a href="https://medium.com/@jorgegabriel.ti/embarking-on-the-go-journey-from-absolute-zero-to-your-first-module-644935f5171d" target="_blank" class="article-item">
          <span class="article-arrow">→</span>
          <span>Embarking on the Go Journey: From Absolute Zero to Your First Module</span>
        </a>
        <a href="https://medium.com/@jorgegabriel.ti/hardware-uma-vis%C3%A3o-geral-da-anatomia-do-computador-e6ce24eaccf4" target="_blank" class="article-item">
          <span class="article-arrow">→</span>
          <span>Hardware — Uma visão geral da anatomia do computador</span>
        </a>
        <a href="https://medium.com/@jorgegabriel.ti/day-1-parte-6-upgrade-do-cluster-kubernetes-v1-31-para-v1-32-workers-nodes-f2887b255ff3" target="_blank" class="article-item">
          <span class="article-arrow">→</span>
          <span>Day 1 — Parte 6: Upgrade do Cluster Kubernetes v1.31 para v1.32 — Workers Nodes</span>
        </a>
        <a href="https://medium.com/@jorgegabriel.ti/day-1-parte-5-upgrade-do-cluster-kubernetes-v1-31-para-v1-32-dde5b2a1c140" target="_blank" class="article-item">
          <span class="article-arrow">→</span>
          <span>Day 1 — Parte 5: Upgrade do Cluster Kubernetes v1.31 para v1.32 — Control Plane</span>
        </a>
        <a href="https://medium.com/@jorgegabriel.ti" target="_blank" class="read-more">
          View all articles on Medium →
        </a>
      </div>
    </section>

  </main>
</Layout>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .skill-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 1rem;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    transition: all 0.2s ease;
  }

  .skill-card:hover {
    border-color: var(--green);
    box-shadow: 0 0 12px rgba(0, 255, 153, 0.1);
  }

  .skill-name {
    color: var(--text);
    font-weight: 500;
  }
</style>
