---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Education | Jorge Gabriel" activeNav="/formacao">
  <div class="page-content">
    <header class="section">
      <h1 class="page-title">Education</h1>
      <p class="page-subtitle">Certifications and academic background</p>
    </header>

    <section class="section">
      <h2 class="section-title"><span class="hash">#</span> Certifications</h2>
      <div class="certifications-list">
        <div class="cert-item">
          <div class="cert-header">
            <h3 class="cert-name">AWS Certified AI Practitioner</h3>
            <a href="https://credly.com/badges/d9499388" target="_blank" rel="noopener noreferrer" class="cert-link">
              View Credential
            </a>
          </div>
          <p class="cert-date">Issued by Amazon Web Services (AWS)</p>
        </div>

        <div class="cert-item">
          <div class="cert-header">
            <h3 class="cert-name">AWS Certified Cloud Practitioner</h3>
            <a href="https://credly.com/badges/c9572e3b" target="_blank" rel="noopener noreferrer" class="cert-link">
              View Credential
            </a>
          </div>
          <p class="cert-date">Issued by Amazon Web Services (AWS)</p>
        </div>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title"><span class="hash">#</span> Academic Background</h2>
      <div class="education-list">
        <div class="education-item">
          <div class="education-header">
            <h3 class="education-degree">Postgraduate – Go Expert</h3>
            <span class="education-status in-progress">In Progress</span>
          </div>
          <p class="education-school">FCTECH</p>
        </div>

        <div class="education-item">
          <div class="education-header">
            <h3 class="education-degree">Technical Degree – Systems Development</h3>
            <span class="education-status in-progress">In Progress</span>
          </div>
          <p class="education-school">Senac-RS</p>
        </div>

        <div class="education-item">
          <div class="education-header">
            <h3 class="education-degree">Postgraduate – DevOps & Cloud</h3>
            <span class="education-status completed">Completed</span>
          </div>
          <p class="education-school">Senai Fatesg</p>
        </div>

        <div class="education-item">
          <div class="education-header">
            <h3 class="education-degree">Technologist Degree – Computer Networks</h3>
            <span class="education-status completed">Completed</span>
          </div>
          <p class="education-school">Senai Fatesg</p>
        </div>

        <div class="education-item">
          <div class="education-header">
            <h3 class="education-degree">Technical Degree – Computer Networks</h3>
            <span class="education-status completed">Completed</span>
          </div>
          <p class="education-school">Senai Fatesg</p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .page-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .certifications-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .cert-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1.5rem;
    transition: all 0.2s ease;
  }

  .cert-item:hover {
    border-color: var(--green);
    box-shadow: 0 0 12px rgba(0, 255, 153, 0.1);
  }

  .cert-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .cert-name {
    color: var(--green);
    font-size: 1.1rem;
    margin: 0;
    font-weight: 600;
  }

  .cert-link {
    color: var(--blue);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.5rem 1rem;
    border: 1px solid rgba(88, 166, 255, 0.3);
    border-radius: 4px;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .cert-link:hover {
    border-color: var(--blue);
    background: rgba(88, 166, 255, 0.1);
  }

  .cert-date {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin: 0;
  }

  .education-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .education-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1.5rem;
    transition: border-color 0.2s ease;
  }

  .education-item:hover {
    border-color: var(--blue);
  }

  .education-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .education-degree {
    color: var(--text);
    font-size: 1.1rem;
    margin: 0;
    font-weight: 600;
  }

  .education-status {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    flex-shrink: 0;
    font-weight: 500;
  }

  .education-status.in-progress {
    background: rgba(0, 255, 153, 0.15);
    color: var(--green);
    border: 1px solid rgba(0, 255, 153, 0.3);
  }

  .education-status.completed {
    background: rgba(88, 166, 255, 0.15);
    color: var(--blue);
    border: 1px solid rgba(88, 166, 255, 0.3);
  }

  .education-school {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin: 0;
  }
</style>
