---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Jorge Gabriel" activeNav="/contato">
  <div class="page-content">
    <header class="section">
      <h1 class="page-title">Get in Touch</h1>
      <p class="page-subtitle">Let's connect and collaborate</p>
    </header>

    <div class="contact-grid">
      <div class="card contact-card">
        <div class="contact-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"></path>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </div>
        <h3 class="contact-title">LinkedIn</h3>
        <p class="contact-description">Connect with me professionally</p>
        <a href="https://linkedin.com/in/jorge-gabriel" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Visit Profile
        </a>
      </div>

      <div class="card contact-card">
        <div class="contact-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-1.02-2.47c3.34-.35 6.85-1.65 6.85-7.5a5.88 5.88 0 00-1.7-4.1 5.35 5.35 0 00-.1-4.2s-1.5-.45-4.92 1.6a16.68 16.68 0 00-9 0C6.76 1.45 5.26 1.9 5.26 1.9a5.35 5.35 0 00-.1 4.2 5.88 5.88 0 00-1.7 4.1c0 5.8 3.51 7.15 6.85 7.5a3.37 3.37 0 00-1.02 2.47v3.87"></path>
          </svg>
        </div>
        <h3 class="contact-title">GitHub</h3>
        <p class="contact-description">Check out my open source work</p>
        <a href="https://github.com/jorgegabrielti" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          View Projects
        </a>
      </div>

      <div class="card contact-card">
        <div class="contact-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V7M3 7l9 6 9-6M3 7h18"></path>
          </svg>
        </div>
        <h3 class="contact-title">Medium</h3>
        <p class="contact-description">Read my technical articles and insights</p>
        <a href="https://medium.com/@jorgegabriel.ti" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Read Articles
        </a>
      </div>
    </div>

    <section class="section contact-cta">
      <h2 class="section-title">Want to work together?</h2>
      <p class="cta-text">
        I'm always interested in hearing about interesting projects and opportunities. 
        Feel free to reach out through any of the channels above!
      </p>
    </section>
  </div>
</Layout>

<style>
  .page-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .contact-card:hover {
    border-color: var(--blue);
    box-shadow: 0 0 20px rgba(88, 166, 255, 0.1);
    transform: translateY(-2px);
  }

  .contact-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    color: var(--blue);
  }

  .contact-icon svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
  }

  .contact-title {
    color: var(--text);
    font-size: 1.25rem;
    margin: 0 0 0.5rem 0;
    font-weight: 600;
  }

  .contact-description {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin: 0 0 1.5rem 0;
    line-height: 1.5;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    border: 1px solid;
  }

  .btn-primary {
    background: var(--blue);
    color: var(--bg);
    border-color: var(--blue);
  }

  .btn-primary:hover {
    background: transparent;
    color: var(--blue);
    box-shadow: 0 0 12px rgba(88, 166, 255, 0.3);
  }

  .contact-cta {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 2rem;
    margin-top: 1rem;
    text-align: center;
  }

  .contact-cta .section-title {
    color: var(--green);
    margin-top: 0;
  }

  .cta-text {
    color: var(--text);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 500px;
    margin: 1.5rem auto 0;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-cta {
      padding: 1.5rem;
    }
  }
</style>
