---
export interface Props {
  title: string;
  description: string;
  activeNav?: string;
}
const { title, description, activeNav } = Astro.props;

const navLinks = [
  { href: '/',            label: 'Home'       },
  { href: '/experiencia', label: 'Experience' },
  { href: '/projetos',    label: 'Projects'   },
  { href: '/formacao',    label: 'Education'  },
  { href: '/contato',     label: 'Contact'    },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="author" content="Jorge Gabriel" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;500;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <nav class="navbar">
    <a href="/" class="nav-brand"><span class="brand-dollar">$</span>jorge@sre</a>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">☰</button>
    <ul class="nav-links" id="navLinks">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class={`nav-link ${activeNav === link.href ? 'active' : ''}`}>
            {link.label}
          </a>
        </li>
      ))}
      <li><a href="https://linkedin.com/in/jorge-gabriel" target="_blank" class="nav-cta">Hire Me →</a></li>
    </ul>
  </nav>
  <div class="container">
    <slot />
  </div>
  <footer>
    <p><span class="green">jorge@sre</span>:<span class="blue">~</span>$ echo "Built with Astro · GitHub Pages"</p>
  </footer>
  <script>
    const toggle = document.getElementById('navToggle');
    const links  = document.getElementById('navLinks');
    toggle?.addEventListener('click', () => links?.classList.toggle('open'));
  </script>
</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg:        #0d1117;
    --bg-card:   #161b22;
    --bg-hover:  #1f2937;
    --border:    #30363d;
    --green:     #00ff99;
    --green-dim: #00cc7a;
    --blue:      #58a6ff;
    --yellow:    #ffd700;
    --red:       #ff6b6b;
    --text:      #c9d1d9;
    --text-dim:  #8b949e;
    --font-mono: 'Fira Code', monospace;
    --font-sans: 'Inter', sans-serif;
    --nav-h:     60px;
  }

  html { scroll-behavior: smooth; }

  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.7;
    min-height: 100vh;
  }

  /* Navbar */
  .navbar {
    position: sticky; top: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 2rem; height: var(--nav-h);
    background: rgba(13,17,23,.95); backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .nav-brand { font-family: var(--font-mono); font-size: 1rem; font-weight: 600; transition: color .2s; }
  .nav-brand:hover { color: var(--green); }
  .brand-dollar { color: var(--green); }
  .nav-links { display: flex; align-items: center; gap: .2rem; list-style: none; }
  .nav-link { font-family: var(--font-mono); font-size: .82rem; color: var(--text-dim); padding: .4rem .7rem; border-radius: 6px; transition: all .2s; }
  .nav-link:hover, .nav-link.active { color: var(--green); background: rgba(0,255,153,.07); }
  .nav-link.active { border-bottom: 2px solid var(--green); border-radius: 0; }
  .nav-cta { font-family: var(--font-mono); font-size: .82rem; padding: .4rem .9rem; border: 1px solid var(--green); border-radius: 6px; color: var(--green); margin-left: .5rem; transition: all .2s; }
  .nav-cta:hover { background: var(--green); color: var(--bg); }
  .nav-toggle { display: none; background: none; border: none; color: var(--text); font-size: 1.4rem; cursor: pointer; }

  .container {
    max-width: 860px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  /* Page titles */
  .page-title { font-family: var(--font-mono); font-size: 1.6rem; color: var(--green); margin-bottom: .3rem; }
  .page-subtitle { font-family: var(--font-mono); font-size: .85rem; color: var(--text-dim); margin-bottom: 2.5rem; padding-bottom: 1.2rem; border-bottom: 1px solid var(--border); }
  .page-subtitle::before { content: '// '; color: var(--border); }

  /* Card */
  .card { border: 1px solid var(--border); border-radius: 10px; background: var(--bg-card); padding: 1.4rem 1.6rem; transition: all .2s; }
  .card:hover { border-color: var(--green); box-shadow: 0 0 16px rgba(0,255,153,.08); }

  /* Tags */
  .tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .8rem; }
  .tag { font-family: var(--font-mono); font-size: .72rem; padding: .2rem .6rem; border: 1px solid var(--border); border-radius: 4px; color: var(--text-dim); background: var(--bg); }

  /* Buttons */
  .btn { display: inline-flex; align-items: center; gap: .4rem; padding: .45rem .9rem; border-radius: 6px; font-family: var(--font-mono); font-size: .82rem; border: 1px solid var(--border); color: var(--text); background: var(--bg-card); transition: all .2s; }
  .btn:hover { border-color: var(--green); color: var(--green); }
  .btn-primary { border-color: var(--green); color: var(--green); }
  .btn-primary:hover { background: var(--green); color: var(--bg); }

  a { color: inherit; text-decoration: none; }

  /* ── Hero / Terminal ── */
  .hero {
    margin: 3rem 0 4rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0,255,153,0.05);
  }

  .terminal-header {
    background: #1c2128;
    padding: .6rem 1rem;
    display: flex;
    align-items: center;
    gap: .5rem;
    border-bottom: 1px solid var(--border);
  }

  .dot { width: 12px; height: 12px; border-radius: 50%; }
  .red    { background: #ff5f57; }
  .yellow { background: #febc2e; }
  .green  { background: #28c840; }

  .terminal-title {
    font-family: var(--font-mono);
    font-size: .8rem;
    color: var(--text-dim);
    margin-left: .5rem;
  }

  .terminal-body {
    background: var(--bg);
    padding: 1.8rem 2rem;
    font-family: var(--font-mono);
  }

  .prompt {
    color: var(--text-dim);
    font-size: .9rem;
    margin-top: .8rem;
  }

  .dollar { color: var(--green); margin-right: .5rem; }

  .name {
    color: var(--green);
    font-size: 2.2rem;
    font-weight: 600;
    font-family: var(--font-mono);
    letter-spacing: -1px;
    margin: .2rem 0 .8rem;
  }

  .role {
    font-size: 1.1rem;
    color: var(--blue);
    margin: .2rem 0 .8rem;
  }

  .cursor {
    animation: blink 1s step-end infinite;
    color: var(--green);
  }

  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

  .bio {
    color: var(--text);
    font-family: var(--font-sans);
    font-size: .95rem;
    margin: .2rem 0 1.5rem;
    max-width: 600px;
  }

  .bio strong { color: var(--green); }

  .links { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: .5rem; }

  .link-btn {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .4rem .9rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: .85rem;
    color: var(--text);
    background: var(--bg-card);
    transition: all .2s ease;
  }

  .link-btn:hover {
    border-color: var(--green);
    color: var(--green);
    box-shadow: 0 0 10px rgba(0,255,153,.15);
  }

  /* ── Sections ── */
  .section { margin-bottom: 3.5rem; }

  .section-title {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    color: var(--text-dim);
    margin-bottom: 1.5rem;
    padding-bottom: .5rem;
    border-bottom: 1px solid var(--border);
  }

  .hash { color: var(--green); margin-right: .5rem; }

  /* ── Stack Grid ── */
  .stack-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .stack-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .4rem;
    padding: .8rem 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-card);
    font-size: .75rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
    transition: all .2s ease;
    min-width: 70px;
  }

  .stack-item img { width: 40px; height: 40px; }

  .stack-item:hover {
    border-color: var(--green);
    color: var(--green);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0,255,153,.1);
  }

  /* ── Certifications ── */
  .cert-grid { display: flex; flex-direction: column; gap: 1rem; }

  .cert-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-card);
    transition: all .2s ease;
  }

  .cert-card:hover {
    border-color: var(--green);
    box-shadow: 0 0 12px rgba(0,255,153,.1);
  }

  .cert-icon { font-size: 1.5rem; }

  .cert-name {
    font-weight: 500;
    color: var(--text);
    font-size: .95rem;
  }

  .cert-issuer {
    font-size: .8rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
    margin-top: .15rem;
  }

  /* ── Articles ── */
  .articles-list { display: flex; flex-direction: column; gap: .6rem; }

  .article-item {
    display: flex;
    align-items: flex-start;
    gap: .75rem;
    padding: .8rem 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-card);
    font-size: .9rem;
    color: var(--text);
    transition: all .2s ease;
    line-height: 1.5;
  }

  .article-item:hover {
    border-color: var(--green);
    color: var(--green);
    transform: translateX(4px);
  }

  .article-arrow {
    color: var(--green);
    font-family: var(--font-mono);
    flex-shrink: 0;
    margin-top: .1rem;
  }

  .read-more {
    display: inline-block;
    margin-top: .5rem;
    font-family: var(--font-mono);
    font-size: .85rem;
    color: var(--text-dim);
    padding: .3rem 0;
    transition: color .2s;
  }

  .read-more:hover { color: var(--green); }

  /* ── Footer ── */
  footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: .8rem;
    color: var(--text-dim);
  }

  footer .green { color: var(--green); }
  footer .blue  { color: var(--blue); }

  /* Responsive */
  @media (max-width: 680px) {
    .nav-toggle { display: block; }
    .nav-links { display: none; position: absolute; top: var(--nav-h); left: 0; right: 0; flex-direction: column; background: var(--bg); border-bottom: 1px solid var(--border); padding: 1rem; gap: .2rem; }
    .nav-links.open { display: flex; }
    .nav-cta { margin-left: 0; }
    .name { font-size: 1.6rem; }
    .terminal-body { padding: 1.2rem; }
    .stack-grid { gap: .6rem; }
    .stack-item { min-width: 60px; padding: .6rem .7rem; }
  }
</style>
